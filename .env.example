# Optional. Without these, the prototype runs in DEMO mode:
# - the 6-digit OTP code is displayed on screen instead of being emailed
# - profiles and donations are stored in this browser's localStorage
#
# To enable real e-mail OTP + shared database, create a Supabase project,
# run supabase/schema.sql in its SQL editor, then fill these two values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin account e-mail. Default: admin@giveflow.local (demo mode).
# Public in the browser bundle — prototype gate only.
VITE_ADMIN_EMAIL=
